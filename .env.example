# Canonical production URL, used for canonical links, sitemap and robots.txt.
# Defaults to https://jinling-blog.pages.dev. Change it when moving to a custom domain.
SITE_URL=https://jinling-blog.pages.dev

# GitHub repository used by the "Edit this page" link.
GITHUB_REPOSITORY=your-github-name/JinLingBlog

# Public Giscus values from https://giscus.app/zh-CN
VITE_GISCUS_REPO=your-github-name/JinLingBlog
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=

# Search-engine verification codes: only the content="..." value of each
# provider's HTML meta tag. Set them in Cloudflare Pages, then redeploy.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=

# Used by `pnpm submit:urls` after a deploy. Keep the real values in .env.local.
# INDEXNOW_KEY must also be set in Cloudflare Pages so /<key>.txt is published.
BAIDU_PUSH_TOKEN=
INDEXNOW_KEY=

